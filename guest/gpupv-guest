def mesa_files():
    triplet = sysconfig.get_config_var("MULTIARCH")
    dirs = [Path("/usr/lib64/dri"),Path("/usr/lib/dri")]
    if triplet:
        dirs.append(Path("/usr/lib") / triplet / "dri")
    return [p for p in (d / "d3d12_drv_video.so" for d in dirs) if p.is_file()]


def fail(reason):
    raise RuntimeError(reason)


def copy_install_tree(source,dest):
    shutil.copytree(source,dest,copy_function=shutil.copyfile)
    for directory,_,files in os.walk(dest):
        os.chmod(directory,0o755)
        for name in files:
            os.chmod(os.path.join(directory,name),0o644)


def secure_boot():
    if not Path("/sys/firmware/efi").exists():
        return False
    variables = list(Path("/sys/firmware/efi/efivars").glob("SecureBoot-*"))
    if len(variables) != 1:
        fail("Unable to read Secure Boot state from efivarfs (/sys/firmware/efi/efivars).")
    flag = variables[0].read_bytes()[4:]
    if flag not in (b"\0", b"\1"):
        fail("Invalid Secure Boot variable")
    return flag == b"\1"


def distro_pkg_manager():
    for mgr in ("apt-get", "dnf", "yum", "zypper", "pacman", "tdnf"):
        if shutil.which(mgr):
            return mgr
    return None


def build_deps_hint(compiler):
    mgr = distro_pkg_manager()
    if mgr == "apt-get":
        return f"sudo apt-get update && sudo apt-get install -y linux-headers-{RELEASE} make {compiler}"
    if mgr in ("dnf", "yum"):
        hdr = f"kernel-uek-devel-{RELEASE}" if "uek" in RELEASE else f"kernel-devel-{RELEASE}"
        return f"sudo {mgr} install -y {hdr} make {compiler}"
    if mgr == "zypper":
        return f"sudo zypper install -y kernel-default-devel make {compiler}"
    if mgr == "pacman":
        return f"sudo pacman -S --needed base-devel {compiler} (plus matching kernel headers)"
    if mgr == "tdnf":
        return f"sudo tdnf install -y kernel-devel make {compiler}"
    return f"install matching kernel headers for {RELEASE}, make, and {compiler}"


def runtime_tools_hint(missing):
    pkg_map = {
        "modprobe": "kmod", "modinfo": "kmod", "depmod": "kmod",
        "udevadm": "udev", "ldconfig": "glibc", "make": "make",
        "gcc": "gcc", "clang": "clang",
    }
    pkgs = " ".join(dict.fromkeys(pkg_map.get(t, t) for t in missing))
    mgr = distro_pkg_manager()
    if mgr == "apt-get":
        return f"sudo apt-get update && sudo apt-get install -y {pkgs}"
    if mgr in ("dnf", "yum", "zypper", "tdnf"):
        return f"sudo {mgr} install -y {pkgs}"
    if mgr == "pacman":
        return f"sudo pacman -S --needed {pkgs}"
    return f"install required packages ({pkgs})"


def adapters(device):
    cards = device.get("adapters", [device])
    if not isinstance(cards, list) or not cards:
        fail("device.json must identify at least one adapter")
    for card in cards:
        pkg = card["package"]
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", pkg) or pkg in (".", ".."):
            fail("Invalid driver package directory")
    return cards


def elf(path, arch, types):
    with path.open("rb") as f:
        h = f.read(64)
    if (len(h) != 64 or h[:6] != b"\x7fELF\x02\x01" or
        int.from_bytes(h[16:18],"little") not in types or
        int.from_bytes(h[18:20],"little") != {"x86_64":62,"aarch64":183}.get(arch)):
        fail("ELF architecture/type mismatch: " + str(path))


def bundle_info():
    path = BUNDLE / "manifest.json"
    if not path.exists():
        return None
    meta = json.loads(path.read_text())
    if meta["schemaVersion"] != 1 or meta["arch"] != platform.machine():
        fail(f"Bundle arch ({meta['arch']}) or schemaVersion ({meta['schemaVersion']}) does not match guest ({platform.machine()}).")
    return meta


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def symbol_versions(module):
    result = sp.run(["modprobe", "--dump-modversions", str(module)], stdout=sp.PIPE,
                    stderr=sp.DEVNULL, universal_newlines=True)
    if result.returncode:
        return {}
    return {name: int(crc, 16) for crc, name in
            re.findall(r"^(0x[\da-fA-F]+)\s+(\w+)$", result.stdout, re.M)}


def prebuilt_abi_mismatch(module):
    # Ubuntu GA and HWE can share uname -r and vermagic but export different CRCs.
    if not shutil.which("modprobe"):
        return None
    required = symbol_versions(module)
    if not required:
        return None
    for driver in ("pci_hyperv", "hv_netvsc"):
        result = sp.run(["modinfo", "-n", driver], stdout=sp.PIPE, stderr=sp.DEVNULL,
                        universal_newlines=True)
        reference = Path(result.stdout.strip())
        if result.returncode or not reference.is_file():
            continue
        for name, crc in symbol_versions(reference).items():
            if name in required and required[name] != crc:
                return "{} ({:#010x} != {:#010x}, {})".format(name, required[name], crc, driver)
    return None


def prebuilt(meta):
    if BUNDLE == HOME and (HOME/"install.json").is_file():
        info = check_owner()
        if info.get("complete") and info["release"] == RELEASE and not info.get("dkms"):
            path = HOME/"dxgkrnl.ko"
            if digest(path) != info["module_sha256"]:
                fail("Installed module checksum mismatch")
            return path
        return None
    if meta is None:
        return None
    entries = json.loads((BUNDLE/"prebuilt/index.json").read_text())
    if entries != meta["kernels"]:
        fail("Prebuilt index differs from deployment manifest")
    matches = [item for item in entries if item["release"] == RELEASE and item["arch"] == meta["arch"]]
    if not matches:
        return None
    path = BUNDLE/"prebuilt"/meta["arch"]/RELEASE/"dxgkrnl.ko"
    if len(matches) != 1 or digest(path) != matches[0]["sha256"]:
        fail("Prebuilt module checksum mismatch")
    elf(path, meta["arch"], (1,))
    for field in ("name","vermagic","srcversion"):
        actual = sp.check_output(["modinfo","-F",field,str(path)],universal_newlines=True).strip()
        if actual != matches[0][field]:
            fail("Prebuilt module metadata mismatch: "+field)
    if matches[0]["name"] != "dxgkrnl" or matches[0]["vermagic"].split()[0] != RELEASE:
        fail("Incompatible prebuilt module")
    mismatch = prebuilt_abi_mismatch(path)
    if mismatch:
        print("Prebuilt kernel ABI mismatch: {}. Using matching kernel headers.".format(mismatch),
              file=sys.stderr, flush=True)
        return None
    return path


def doctor():
    problems = []
    try:
        libc = os.confstr("CS_GNU_LIBC_VERSION") or ""
    except (ValueError, OSError):
        libc = ""
    if not libc.startswith("glibc "):
        problems.append("Unsupported C library: glibc is required (musl systems such as Alpine are not supported).")
    try:
        grp.getgrnam("video")
    except KeyError:
        problems.append("Group 'video' does not exist. Run: sudo groupadd video && sudo usermod -aG video $USER")
    if os.statvfs("/").f_flag & os.ST_RDONLY or Path("/etc/NIXOS").exists() or Path("/run/ostree-booted").exists():
        problems.append("Read-only or immutable root filesystem detected (e.g. NixOS or ostree). A writable VM root is required.")
    secure_boot()
    meta = bundle_info()
    module = prebuilt(meta)
    tools = ["modprobe", "modinfo", "depmod", "ldconfig", "udevadm"]
    if module is None:
        conf = HEADERS/"include/config/auto.conf"
        compiler = "clang" if conf.exists() and "CONFIG_CC_IS_CLANG=y" in conf.read_text() else "gcc"
        release_files = (HEADERS / "include/generated/utsrelease.h", HEADERS / "include/config/kernel.release")
        if not any(p.is_file() and RELEASE in re.findall(r'[^"\s]+', p.read_text()) for p in release_files):
            problems.append(f"Missing kernel headers matching {RELEASE} at {HEADERS}. Run: {build_deps_hint(compiler)}")
        tools += ["make", compiler]
    if RELEASE.startswith("5.4.") and "Ubuntu" in platform.version():
        problems.append("Ubuntu 5.4 GA kernel lacks required pin_user_pages_fast API. Upgrade to an Ubuntu HWE kernel and reboot.")
    if not any(p.read_text().strip()=="0x008e" and (p.parent/"vendor").read_text().strip()=="0x1414"
               for p in Path("/sys/bus/pci/devices").glob("*/device")):
        driver = Path("/sys/bus/vmbus/drivers/hv_pci")
        if not driver.exists() and shutil.which("modinfo") and sp.run(
                ["modinfo", "pci_hyperv"], stdout=sp.DEVNULL, stderr=sp.DEVNULL).returncode:
            extra = (f" Run: sudo apt-get update && sudo apt-get install -y linux-modules-extra-{RELEASE} && sudo modprobe pci_hyperv"
                     if distro_pkg_manager() == "apt-get" else "")
            problems.append(f"Missing pci_hyperv kernel driver (CONFIG_PCI_HYPERV disabled or module not installed).{extra}")
        else:
            problems.append("GPU-PV virtual PCI device (1414:008e) not detected. Ensure a GPU partition is assigned to this VM in Hyper-V / ExHyperV.")
    missing_tools = [tool for tool in tools if not shutil.which(tool)]
    if missing_tools:
        problems.append(f"Missing required tools ({', '.join(missing_tools)}). Run: {runtime_tools_hint(missing_tools)}")
    manifest = BUNDLE / "device.json"
    if not manifest.is_file():
        problems.append("Host device manifest (device.json) is missing. Recreate the GPUPV ISO using ExHyperV 2.0.0+ or gpupv-host.ps1.")
    else:
        device = json.loads(manifest.read_text())
        arch = platform.machine()
        if device["arch"] != arch:
            problems.append(f"Host bundle arch ({device['arch']}) does not match guest arch ({arch}).")
        for name in REQUIRED:
            p = BUNDLE / "lib" / name
            head = b""
            if p.is_file():
                with p.open("rb") as f:
                    head = f.read(64)
            if (len(head) != 64 or head[:6] != b"\x7fELF\x02\x01" or
                int.from_bytes(head[16:18], "little") != 3 or
                int.from_bytes(head[18:20], "little") != {"x86_64":62,"aarch64":183}.get(arch)):
                problems.append(f"Microsoft runtime {name} is missing or has the wrong ELF architecture. Rebuild media with the matching {arch} bundle.")
        for card in adapters(device):
            if not (BUNDLE/"drivers"/card["package"]).is_dir():
                problems.append("Host GPU driver directory missing from media: " + card["package"])
        if meta:
            for name in REQUIRED:
                if digest(BUNDLE/"lib"/name) != meta["libraries"][name]:
                    fail("Runtime library checksum mismatch: " + name)
            probe = BUNDLE/"guest/d3d12-compute"
            elf(probe, arch, (2,3))
            if digest(probe) != meta["probeSha256"]:
                fail("Compute probe checksum mismatch")
    if problems:
        fail("Preflight check failed:\n  - " + "\n  - ".join(problems))
    print(f"{libc}, {platform.machine()}, kernel {RELEASE}, preflight OK", flush=True)
    return module


def preflight():
    return doctor()


def links(release, dkms=False, nv_smi=False):
    paths = {
        Path("/usr/local/bin/gpupv-guest"): HOME / "guest/gpupv-guest",
        WSL / "lib": HOME / "lib",
        WSL / "drivers": HOME / "drivers",
        Path("/etc/modules-load.d/gpupv.conf"): HOME / "modules.conf",
        Path("/etc/modprobe.d/gpupv.conf"): HOME / "order.conf",
        Path("/etc/udev/rules.d/70-gpupv.rules"): HOME / "device.rules",
        Path("/etc/ld.so.conf.d/gpupv.conf"): HOME / "loader.conf",
    }
    if dkms:
        paths[Path("/usr/src/gpupv-dxgkrnl-0.1")] = HOME / "kernel"
    else:
        paths[Path("/lib/modules") / release / "updates/gpupv/dxgkrnl.ko"] = HOME / "dxgkrnl.ko"
    if nv_smi:
        paths[Path("/usr/local/bin/nvidia-smi")] = HOME / "lib/nvidia-smi"
    return paths


def check_owner():
    stamp = HOME / "install.json"
    if HOME.is_symlink() or not stamp.is_file() or stamp.is_symlink():
        fail(f"Found unowned or incomplete directory at {HOME} (missing install.json). Inspect or remove it before retrying.")
    return json.loads(stamp.read_text())


def owned_path(dest, src, info):
    if dest.is_symlink():
        return Path(os.readlink(dest)) == src
    if src == HOME / "dxgkrnl.ko" and info.get("module_sha256") and dest.is_file():
        return hashlib.sha256(dest.read_bytes()).hexdigest() == info["module_sha256"]
    return False


def record_install(info):
    stage = HOME / ".install.new"
    stage.write_text(json.dumps(info))
    stage.replace(HOME / "install.json")


def publish_module(src, dest, info):
    # Keep the real inode under the distribution's module policy path.
    info["module_sha256"] = hashlib.sha256(src.read_bytes()).hexdigest()
    record_install(info)
    with tempfile.NamedTemporaryFile(dir=dest.parent, delete=False) as out:
        tmp = Path(out.name)
    try:
        shutil.copyfile(src, tmp)
        tmp.chmod(0o644)
        if dest.is_symlink() and Path(os.readlink(dest)) == src:
            tmp.replace(dest)
        else:
            os.link(tmp, dest)
        if Path("/sys/fs/selinux/enforce").is_file():
            sp.run(["restorecon", "-F", str(dest.resolve())], check=True)
    finally:
        with contextlib.suppress(FileNotFoundError):
            tmp.unlink()


def unload():
    if Path("/sys/module/dxgkrnl").exists():
        sp.run(["modprobe", "-r", "dxgkrnl"], check=True)


def signing_pair(dkms=False):
    if not shutil.which("mokutil") or not shutil.which("openssl"):
        fail("Secure Boot module signing requires 'mokutil' and 'openssl'. Install both from your distribution packages.")
    pairs = [(Path(k), Path(c)) for k, c in (
        ("/var/lib/shim-signed/mok/MOK.priv", "/var/lib/shim-signed/mok/MOK.der"),
        ("/var/lib/dkms/mok.key", "/var/lib/dkms/mok.pub"),
        ("/var/lib/gpupv-signing/MOK.priv", "/var/lib/gpupv-signing/MOK.der"))]
    if dkms and shutil.which("update-secureboot-policy") and Path("/usr/lib/shim/mok/openssl.cnf").is_file():
        # Ubuntu DKMS signs again after MAKE and may prompt inside a headless install.
        # Enroll its distribution key before adding the module to the DKMS tree.
        key, cert = pairs[0]
        if not os.path.lexists(key) and not os.path.lexists(cert):
            sp.run(["update-secureboot-policy", "--new-key"], check=True)
        if not (key.is_file() and cert.is_file()):
            fail(f"Ubuntu DKMS signing requires both {key} and {cert}.")
        pairs = [(key, cert)]
    available = [(k,c) for k,c in pairs if k.is_file() and c.is_file()]
    if not available and shutil.which("dkms"):
        sp.run(["dkms", "generate_mok"], stdout=sp.DEVNULL, stderr=sp.DEVNULL)
        available = [(k,c) for k,c in pairs if k.is_file() and c.is_file()]
    if not available:
        key, cert = pairs[-1]
        key.parent.mkdir(mode=0o700, exist_ok=True)
        if key.parent.is_symlink() or key.parent.stat().st_uid != 0 or key.parent.stat().st_mode & 0o077:
            fail(f"Signing key directory {key.parent} must be owned by root with mode 0700.")
        if os.path.lexists(key) or os.path.lexists(cert):
            fail(f"Incomplete MOK key pair found in {key.parent}. Inspect or clean up existing key files.")
        with tempfile.TemporaryDirectory(dir=str(key.parent)) as tmp:
            private, public = Path(tmp)/key.name, Path(tmp)/cert.name
            sp.run(["openssl","req","-new","-x509","-newkey","rsa:3072","-nodes",
                    "-days","3650","-subj","/CN=GPU-PV module signing/",
                    "-addext","extendedKeyUsage=codeSigning","-keyout",str(private),
                    "-outform","DER","-out",str(public)], check=True)
            private.chmod(0o600)
            private.rename(key)
            public.rename(cert)
        available.append((key,cert))
    # mokutil --test-key has returned nonzero even for an enrolled MOK on Debian.
    # Compare the actual DER certificate exported from the firmware MOK list.
    with tempfile.TemporaryDirectory() as exported:
        sp.run(["mokutil","--export"], cwd=exported, check=True)
        trusted = {p.read_bytes() for p in Path(exported).glob("*.der")}
        for key, cert in available:
            if cert.read_bytes() in trusted:
                return key, cert
    cert = available[0][1]
    fail(f"Secure Boot MOK certificate is not enrolled in firmware yet.\nRun:\n  sudo mokutil --import {cert}\n"
         "Set a one-time password, reboot into the blue MOK Manager screen -> Enroll MOK, then re-run setup.")


def load_trusted():
    try:
        sp.run(["modprobe", "dxgkrnl"], check=True)
    except sp.CalledProcessError as err:
        fail(f"Failed to load dxgkrnl kernel module (modprobe exited {err.returncode}). "
             "Check 'dmesg | tail -n 30' for details. Under Secure Boot or openSUSE third-party module policy, verify MOK enrollment and kernel trust.")
    if secure_boot() and "E" in Path("/sys/module/dxgkrnl/taint").read_text():
        fail("Running kernel rejected the dxgkrnl signature (module tainted 'E'). Boot via trusted shim and confirm the MOK key is in the kernel keyring.")


def uninstall():
    if not os.path.lexists(HOME):
        print("GPU-PV runtime is not installed.", flush=True)
        return
    print("Uninstalling GPU-PV kernel module, udev rules, and /usr/lib/wsl links...", flush=True)
    info = check_owner()
    dkms = info.get("dkms",False)
    paths = links(info["release"],dkms,info.get("nv_smi",False))
    for dest, src in paths.items():
        if os.path.lexists(dest) and not owned_path(dest, src, info):
            fail(f"Refusing to remove unmanaged file at {dest}. Check ownership before retrying.")
    if info["release"] == RELEASE or dkms:
        unload()
    if dkms:
        source = Path("/var/lib/dkms/gpupv-dxgkrnl/0.1/source")
        if os.path.lexists(source):
            if source.resolve() != HOME / "kernel":
                fail("Existing DKMS registration for gpupv-dxgkrnl/0.1 points elsewhere. Inspect DKMS before uninstalling.")
            sp.run(["dkms","remove","gpupv-dxgkrnl/0.1","--all"],check=True)
    for dest, src in paths.items():
        if owned_path(dest, src, info):
            dest.unlink()
    for d in info["created_dirs"]:
        with contextlib.suppress(OSError):
            Path(d).rmdir()
    shutil.rmtree(HOME)
    sp.run(["depmod", "-a", info["release"]], check=True)
    sp.run(["ldconfig"], check=True)
    sp.run(["udevadm", "control", "--reload"], check=True)
    print("Uninstall complete. Any enrolled MOK keys in firmware were preserved.", flush=True)


def install(dkms=False, with_video=False):
    meta = bundle_info()
    module = prebuilt(meta)
    dkms = dkms and module is None
    pair = signing_pair(dkms=dkms) if secure_boot() else None
    nv_smi = (BUNDLE / "lib/nvidia-smi").is_file()
    paths = links(RELEASE,dkms,nv_smi)
    device = json.loads((BUNDLE / "device.json").read_text())
    cards_label = ", ".join(card["name"] for card in adapters(device))
    if os.path.lexists(HOME):
        info = check_owner()
        if ((info["release"] == RELEASE or dkms) and info.get("dkms",False) == dkms
            and info.get("bundle_version") == (meta and meta["version"]) and info.get("with_video",False)==with_video
            and info["device"] == device and info.get("complete")
            and all(owned_path(d, s, info) and s.exists() for d,s in paths.items())):
            for dest, src in paths.items():
                if src == HOME / "dxgkrnl.ko" and dest.is_symlink():
                    publish_module(src, dest, info)
            load_trusted()
            if not Path("/dev/dxg").is_char_device():
                fail("Installed, but /dev/dxg is missing. Check the VM GPU partition assignment.")
            print(f"GPU-PV runtime is already installed for {RELEASE} ({cards_label}).", flush=True)
            print("Run 'gpupv-guest verify' as a non-root user in the 'video' group.", flush=True)
            return
        fail("Existing or incomplete installation found. Run 'sudo gpupv-guest uninstall' first.")
    for d in paths:
        if os.path.lexists(d):
            fail(f"Refusing to overwrite existing path {d}. Remove or clean up the prior installation first.")
    if dkms:
        if not shutil.which("dkms"):
            fail("DKMS mode requested, but 'dkms' is not installed. Install dkms from your distribution packages.")
        if Path("/var/lib/dkms/gpupv-dxgkrnl/0.1").exists():
            fail("Existing DKMS registration gpupv-dxgkrnl/0.1 found. Inspect or remove it before installing.")
    if Path("/sys/module/dxgkrnl").exists() or sp.run(["modinfo","dxgkrnl"],stdout=sp.DEVNULL,stderr=sp.DEVNULL).returncode == 0:
        fail("An existing dxgkrnl module is already present on this kernel. Verify its origin before replacing it.")
    route = "prebuilt module" if module is not None else ("DKMS source build" if dkms else "source build")
    print(f"[1/4] Module strategy for kernel {RELEASE}: {route}.", flush=True)
    if pair:
        print(f"[2/4] Secure Boot enabled, signing module with enrolled MOK ({pair[1]}).", flush=True)
    else:
        print("[2/4] Secure Boot disabled, skipping module signing.", flush=True)
    print(f"[3/4] Installing dxgkrnl and GPU-PV libraries to {HOME} ({WSL})...", flush=True)
    with tempfile.TemporaryDirectory() as temp:
        build = Path(temp) / "kernel"
        if module is None:
            shutil.copytree(BUNDLE / "kernel", build)
            if not dkms:
                try:
                    sp.run(["sh", str(build / "build"), str(HEADERS)], check=True)
                except sp.CalledProcessError as err:
                    fail(f"Kernel module build failed for {RELEASE} (exit {err.returncode}). Verify headers at {HEADERS} match the running kernel.")
                module = build/"drivers/hv/dxgkrnl/dxgkrnl.ko"
        if not dkms and pair:
            sign_target = Path(temp)/"signed.ko"
            shutil.copyfile(module, sign_target)
            sp.run([sys.executable,str(BUNDLE/"guest/sign-module.py"),*map(str,pair),str(sign_target)],check=True)
            module = sign_target
        HOME.parent.mkdir(exist_ok=True)
        HOME.mkdir(mode=0o755)
        info = dict(device=device, bundle_version=meta and meta["version"], with_video=with_video, release=RELEASE, dkms=dkms, nv_smi=nv_smi, created_dirs=[], complete=False)
        record_install(info)
        try:
            for n in ("lib", "drivers"):
                copy_install_tree(BUNDLE/n, HOME/n)
            copy_install_tree(BUNDLE/"guest", HOME/"guest")
            shutil.copyfile(BUNDLE/"device.json", HOME/"device.json")
            if meta:
                shutil.copyfile(BUNDLE/"manifest.json", HOME/"manifest.json")
            (HOME/"guest/gpupv-guest").chmod(0o755)
            if (HOME/"guest/d3d12-compute").exists():
                (HOME/"guest/d3d12-compute").chmod(0o755)
            elif shutil.which("g++"):
                headers = HOME / "guest/directx-headers/include"
                sp.run(["g++", "-O2", "-std=c++17", "-DINITGUID",
                        "-I", str(headers), "-I", str(headers/"wsl/stubs"),
                        str(HOME/"guest/d3d12-compute.cpp"), "-o", str(HOME/"guest/d3d12-compute"),
                        "-ldl"], check=True)
            smi = HOME/"lib/nvidia-smi"
            if smi.exists():
                smi.chmod(0o755)
            if dkms:
                copy_install_tree(build,HOME/"kernel")
                if pair:
                    (HOME/"signing-key-path").write_text(str(pair[0]))
                    (HOME/"signing-cert-path").write_text(str(pair[1]))
            else:
                shutil.copyfile(module, HOME/"dxgkrnl.ko")
                (HOME/"dxgkrnl.ko").chmod(0o644)
            vgem = with_video and sp.run(["modinfo","vgem"],stdout=sp.DEVNULL,stderr=sp.DEVNULL).returncode == 0
            (HOME/"modules.conf").write_text("dxgkrnl\n" + ("vgem\n" if vgem else ""))
            (HOME/"order.conf").write_text("softdep vgem pre: dxgkrnl\n")
            (HOME/"device.rules").write_text('KERNEL=="dxg", GROUP="video", MODE="0660", TAG+="uaccess"\n'
                                             'ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x1414", ATTR{device}=="0x008e", RUN{builtin}+="kmod load dxgkrnl"\n')
            (HOME/"loader.conf").write_text("/usr/lib/wsl/lib\n")
            for dest, src in paths.items():
                missing = []
                d = dest.parent
                while not d.exists():
                    missing.append(d)
                    d = d.parent
                for d in reversed(missing):
                    d.mkdir()
                    info["created_dirs"].insert(0,str(d))
                    record_install(info)
                if src == HOME / "dxgkrnl.ko":
                    publish_module(src, dest, info)
                else:
                    dest.symlink_to(src)
            if dkms:
                try:
                    sp.run(["dkms","add","gpupv-dxgkrnl/0.1"],check=True)
                    sp.run(["dkms","install","gpupv-dxgkrnl/0.1","-k",RELEASE],check=True)
                except sp.CalledProcessError as err:
                    fail(f"DKMS build/install failed for {RELEASE} (exit {err.returncode}). Check DKMS build logs above.")
            sp.run(["depmod","-a",RELEASE],check=True)
            sp.run(["ldconfig"],check=True)
            sp.run(["udevadm","control","--reload"],check=True)
            load_trusted()
            if vgem:
                sp.run(["modprobe", "vgem"], check=True)
            sp.run(["udevadm","settle","--timeout=10"],check=True)
            if not Path("/dev/dxg").is_char_device():
                fail("Module loaded, but /dev/dxg was not created. Check the VM GPU partition assignment.")
            info["complete"] = True
            record_install(info)
            print(f"[4/4] Install complete ({route}, GPU: {cards_label}).", flush=True)
            print("Next step: switch to a non-root user in the 'video' group and run 'gpupv-guest verify'.", flush=True)
        except BaseException:
            uninstall()
            raise


def check_device():
    if os.getuid() == 0:
        fail("Run 'gpupv-guest verify' as a non-root user in the 'video' group, not as root.")
    if not Path("/dev/dxg").is_char_device():
        fail("/dev/dxg character device not found. Verify dxgkrnl is loaded and a GPU partition is assigned to this VM.")
    try:
        with open("/dev/dxg","rb+",buffering=0):
            pass
    except PermissionError:
        fail("Permission denied opening /dev/dxg. Add your user to the 'video' group (sudo usermod -aG video $USER) and start a new login session.")
    device = check_owner()["device"]
    print("boot_id={} uid={} gpu={}".format(Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
          os.getuid(), ", ".join(card["name"] for card in adapters(device))),flush=True)
    smi = HOME/"lib/nvidia-smi"
    if smi.is_file():
        sp.run([str(smi),"--query-gpu=name,driver_version,memory.total","--format=csv"],check=True)
    return device


def verify_adapter_ids(cards, output):
    expected = Counter()
    for card in cards:
        device = card.get("device", "").upper()
        pci = re.match(r"PCI\\VEN_([0-9A-F]{4})&DEV_([0-9A-F]{4})(?:[&\\]|$)", device)
        acpi = re.match(r"ACPI\\VEN_([A-Z0-9]{4})&DEV_([0-9A-F]{4})(?:[&\\]|$)", device)
        if pci:
            identity = ":".join(pci.groups()).lower()
        elif acpi:
            # DXCore exposes the two four-character ACPI IDs as little-endian UINTs.
            identity = ":".join(format(int.from_bytes(v.encode("ascii"), "little"), "08x")
                                for v in acpi.groups())
        else:
            fail("Unrecognized adapter hardware ID: " + device)
        expected[identity] += 1
    observed = Counter(re.findall(r"^Adapter ([0-9a-f]+:[0-9a-f]+) hardware=1$", output, re.M))
    if observed != expected:
        fail("DXCore hardware inventory differs from device.json: expected {}, observed {}".format(expected, observed))


def verify(with_video=False, va_runtime=None):
    device = check_device()
    guest = HOME/"guest"
    result = sp.run([str(guest/"d3d12-compute")], stdout=sp.PIPE, universal_newlines=True)
    print(result.stdout, end="", flush=True)
    if result.returncode:
        fail(f"D3D12 compute probe failed (exit {result.returncode}). Possible causes: guest glibc too old for host driver (e.g. Qualcomm ARM64 needs glibc 2.29+), missing host WSL driver files, or invalid VM MMIO/GPU partition.")
    verify_adapter_ids(adapters(device), result.stdout)
    if ctypes.util.find_library("cuda") or (HOME/"lib/libcuda.so.1").is_file():
        try:
            sp.run([sys.executable,str(guest/"cuda-compute.py")],check=True)
        except sp.CalledProcessError as err:
            fail(f"CUDA compute verification failed (exit {err.returncode}). Check host NVIDIA driver compatibility and /usr/lib/wsl/lib.")
    if ctypes.util.find_library("OpenCL"):
        rc = sp.run([sys.executable,str(guest/"intel-opencl.py")]).returncode
        if rc not in (0,77):
            fail(f"GPU OpenCL compute failed (exit {rc}). Verify GPU OpenCL ICD configuration and confirm non-GPU system ICDs are not interfering.")
    if with_video:
        env=os.environ.copy()
        if va_runtime:
            runtime=Path(va_runtime).resolve()
            env["PATH"]=str(runtime)+":"+env["PATH"]
            env["LIBVA_DRIVERS_PATH"]=str(runtime/"lib")
        if (HOME/"lib/nvidia-smi").is_file():
            sp.run(["sh",str(guest/"verify-codec")],env=env,check=True)
        if list((HOME/"drivers").glob("*/libigd12dxva64.so")):
            sp.run(["sh",str(guest/"verify-intel-codec")],env=env,check=True)
    print("All compute verification checks passed.", flush=True)


def main():
    parser=argparse.ArgumentParser()
    parser.add_argument("action", choices=("doctor","install","check","verify","uninstall"))
    parser.add_argument("--dkms",action="store_true",help="use DKMS for installation and future kernel builds")
    parser.add_argument("--va-runtime", help="use an isolated Intel VA-API userspace directory for verify")
    parser.add_argument("--with-video",action="store_true")
    args=parser.parse_args()
    action=args.action
    if args.va_runtime and action != "verify":
        parser.error("--va-runtime requires verify")
    if action in ("doctor","install"):
        matched = preflight()
        if action == "doctor":
            route = f"prebuilt module ({RELEASE})" if matched is not None else f"source build using {HEADERS}"
            print(f"Module route: {route}", flush=True)
    if action == "verify":
        verify(args.with_video or bool(args.va_runtime),args.va_runtime)
    if action == "check":
        check_device()
    if action in ("install","uninstall"):
        if os.geteuid():
            fail("Install and uninstall require root privileges (use sudo).")
        os.umask(0o022)
        lock = os.open("/run",os.O_RDONLY | os.O_DIRECTORY)
        try:
            fcntl.flock(lock,fcntl.LOCK_EX)
            if action=="install":
                install(args.dkms,args.with_video)
            else:
                uninstall()
        finally:
            os.close(lock)


if __name__=="__main__":
    try:
        main()
    except (RuntimeError,OSError,ValueError,sp.CalledProcessError) as e:
        sys.exit(str(e))


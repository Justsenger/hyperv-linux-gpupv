#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
if ! command -v python3 >/dev/null 2>&1; then
    for loader in /lib/ld-musl-*.so.1; do
        if test -f "$loader"; then
            echo 'Unsupported C library: musl detected. Please use a glibc-based Linux VM image.' >&2
            exit 1
        fi
    done
    echo 'Missing python3. Install Python 3 from your distribution packages (for example apt install python3, dnf install python3, or pacman -S python) and re-run setup.' >&2
    exit 1
fi
exec python3 -B "$(dirname "$0")/gpupv-guest" install "$@"


#!/bin/sh
# Run on a build machine with prepared distro kernel-devel/headers trees.
# Each argument is a unique label followed by '=' and an absolute build path.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
reports="$root/artifacts/reports/compile-matrix"
mkdir -p "$reports"
test "$#" -gt 0 || { echo 'Pass distro-kernel=/absolute/path/to/build ...' >&2; exit 2; }
failed=0
for entry do
    label=${entry%%=*}
    dir=${entry#*=}
    case "$label" in ''|*[!a-zA-Z0-9_.-]*) exit 2;; esac
    case "$dir" in /*) ;; *) exit 2;; esac
    work=$(mktemp -d)
    cp -R "$root/kernel" "$work/"
    if (set -e; uname -a; cat /etc/os-release; cat "$dir/include/config/kernel.release"; sh "$work/kernel/build" "$dir" && modinfo "$work/kernel/drivers/hv/dxgkrnl/dxgkrnl.ko") > "$reports/$label.log" 2>&1; then
        echo "$label PASS"
    else
        echo "$label FAIL"
        failed=1
    fi
    rm -rf "$work"
done
exit "$failed"


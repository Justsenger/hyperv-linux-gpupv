#!/usr/bin/env python3
"""Prepare one MOK request on the disposable Hyper-V guest before a signed test."""
import os
from pathlib import Path
import runpy
import subprocess
import sys

if os.geteuid() != 0 or not Path("/proc/sys/kernel/hostname").read_text().strip().startswith("gpupv-test-"):
    sys.exit("Expected root on an owned test guest")
scope = runpy.run_path(sys.argv[1])
try:
    scope["signing_pair"]()
    print("already_trusted")
except RuntimeError as error:
    print(str(error), flush=True)
    text = str(error)
    token = "sudo mokutil --import "
    if token not in text:
        raise
    cert = Path(text.split(token, 1)[1].split("，", 1)[0])
    subprocess.run(["openssl","x509","-in",str(cert),"-inform","DER","-noout","-subject","-fingerprint","-sha256"],check=True)
    password = sys.stdin.readline().strip()
    if not password.isalnum() or len(password) < 8:
        sys.exit("Invalid ephemeral test password")
    subprocess.run(["mokutil","--timeout","-1"],check=True)
    subprocess.run(["mokutil","--import",str(cert)], input=(password+"\n"+password+"\n").encode(),check=True)
    subprocess.run(["systemd-run","--on-active=3s","/usr/bin/systemctl","reboot"],check=True)
    print("enrollment_requested")
